    {
      "parameters": {
        "jsCode": "const placed = new Set();\nconst cancelled = new Set();\n\nfor (const { json: row } of $input.all()) {\n  const orderId = String(row[\"Order ID\"] ?? \"\").trim();\n  const eventType = String(row[\"Event Type\"] ?? \"\").trim();\n\n  if (!orderId) continue;\n  if (eventType === \"Order placed\") placed.add(orderId);\n  if (eventType === \"Order cancelled\") cancelled.add(orderId);\n}\n\nconst orderChoices = [...placed]\n  .filter(orderId => !cancelled.has(orderId))\n  .map(orderId => ({ option: orderId }));\n\nreturn [{ json: { orderChoices } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        240
      ],
      "id": "19340cb1-1315-46a6-b9e8-901eb4f40fb0",
      "name": "Build Order Choices"
